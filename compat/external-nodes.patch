+/// Points at witnesses and a watcher already running on the usual ports
+/// with the usual seeds, instead of starting them, so that this keriox can
+/// be checked against nodes of another release.
+fn external(seed: &str, url: &str) -> LocationScheme {
+    let seed: keri_core::prefix::SeedPrefix = seed.parse().unwrap();
+    let (pk, _sk) = seed.derive_key_pair().unwrap();
+    LocationScheme {
+        eid: IdentifierPrefix::Basic(BasicPrefix::Ed25519NT(pk)),
+        scheme: keri_core::oobi::Scheme::Http,
+        url: Url::parse(url).unwrap(),
+    }
+}
